{
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.10",
        "includeFiles": ["backend/**/*.py", "backend/requirements.txt", "backend/.env*"]
      }
    },
    {
      "src": "static-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": ".next"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/main.py" },
    { "src": "/horses", "dest": "/backend/main.py" },
    { "src": "/(.*)", "dest": "/static-frontend/$1" }
  ]
}

{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python",
      "config": {
        "pythonVersion": "3.11"
      }
    },
    {
      "src": "static-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": ".next"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "static-frontend/$1"
    }
  ],
  "build": {
    "env": {
      "NODE_VERSION": "20.x",
      "PYTHON_VERSION": "3.11"
    }
  },
  "installCommand": "cd /vercel/path0 && python3 -m pip install --upgrade pip && pip install -r backend/requirements.txt && cd static-frontend && npm install"
}

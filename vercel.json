{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python",
      "config": {
        "pythonVersion": "3.9"
      }
    },
    {
      "src": "static-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": ".next"
      }
    }
  ],
  "installCommand": "cd api && python -m pip install -r requirements.txt",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/api/auth/(.*)",
      "dest": "/api/auth/$1"
    },
    {
      "src": "/api/health",
      "dest": "/api/health"
    },
    {
      "src": "/api",
      "dest": "/api"
    },
    {
      "src": "/(.*)",
      "dest": "/static-frontend/$1"
    }
  ]
}

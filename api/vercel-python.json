{
  "version": 3,
  "builds": [
    {
      "src": "**/*.py",
      "use": "@vercel/python",
      "config": {
        "pythonVersion": "3.9"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(?<path>.*)",
      "dest": "/api/$path"
    },
    {
      "src": "/",
      "dest": "/api"
    }
  ],
  "installCommand": "python -m pip install -r requirements.txt"
}
{
  "version": 3,
  "builds": [
    {
      "src": "**/*.py",
      "use": "@vercel/python",
      "config": {
        "pythonVersion": "3.9",
        "installCommand": "python -m pip install -r ../backend/requirements.txt"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/$1"
    }
  ]
}
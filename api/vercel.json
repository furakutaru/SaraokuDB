{
  "version": 2,
  "builds": [
    {
      "src": "**/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/horses",
      "dest": "/api/horses"
    },
    {
      "src": "/",
      "dest": "/api/health"
    }
  ]
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Horse {
  id               Int       @id @default(autoincrement())
  auctionId        String?
  name             String
  sex              String?
  age              Int?
  sire             String?
  dam              String?
  damSire          String?
  raceRecord       String?   @db.Text
  weight           String?
  totalPrizeStart  String?
  totalPrizeLatest String?
  soldPrice        String?
  auctionDate      DateTime?
  seller           String?
  diseaseTags      String?
  comment          String?   @db.Text
  imageUrl         String?
  primaryImage     String?
  jbisUrl          String?
  detailUrl        String?
  unsoldCount      Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

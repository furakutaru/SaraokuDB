import { NextResponse } from 'next/server';
import path from 'path';
import fs from 'fs';

export async function GET() {
  try {
    // データファイルのパスを設定
    const dataPath = path.join(process.cwd(), 'public/data/horses_combined.json');
    
    // ファイルが存在するか確認
    if (!fs.existsSync(dataPath)) {
      console.error('Horses data file not found at:', dataPath);
      return NextResponse.json(
        { error: 'Horses data file not found' },
        { status: 404 }
      );
    }
    
    // ファイルを読み込む
    const fileData = fs.readFileSync(dataPath, 'utf8');
    const data = JSON.parse(fileData);
    
    // デバッグ用に最初の馬のデータをログ出力
    if (data.horses && data.horses.length > 0) {
      console.log('First horse data sample:', JSON.stringify(data.horses[0], null, 2));
    }
    
    return NextResponse.json(data);
  } catch (error) {
    console.error('Error reading horse data:', error);
    return NextResponse.json(
      { 
        error: 'Failed to load horse data',
        details: error instanceof Error ? error.message : 'Unknown error'
      },
      { status: 500 }
    );
  }
}

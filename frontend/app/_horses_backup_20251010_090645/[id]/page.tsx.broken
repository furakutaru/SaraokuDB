  id: string | number;
  name: string;
  sex: string;
  age: number;
  color?: string;
  birthday?: string;
  sire: string;
  dam: string;
  dam_sire: string;
  breeder?: string;
  owner?: string;
  trainer?: string;
  stable?: string;
  image_url?: string;
  jbis_url?: string;
  auction_url?: string;
  comment?: string;
  weight?: number | null;
  is_unsold?: boolean;

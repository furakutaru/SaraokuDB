  auction_date: string | null;
  seller?: string;
  unsold_count?: number;
  total_prize_latest?: number;
  created_at?: string;
  updated_at?: string;
  disease_tags?: string | string[];
  primary_image?: string;
  race_records?: RaceRecord[];
  basic_info?: Omit<BasicHorseInfo, 'basic_info'>;

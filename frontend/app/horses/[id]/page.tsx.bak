'use client';

import { useState, useEffect, useMemo, useCallback } from 'react';
import Link from 'next/link';
import Image from 'next/image';
import { useRouter } from 'next/navigation';
import { format } from 'date-fns';
import { ja } from 'date-fns/locale';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from '@/components/ui/card';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
import { Badge } from '@/components/ui/badge';
import HorseImage from '@/components/HorseImage';

// --- 型定義 ---
interface HorseHistory {
  auction_date: string;
  name: string;
  sex: string;
  age: string;
  seller: string;
  race_record: string;
  comment: string;
  sold_price: number;
  total_prize_start: number;
  unsold?: boolean;
  detail_url?: string; // サラオク公式ページへのリンク
  primary_image?: string; // 馬体画像のURL
  disease_tags?: string; // 病歴タグ
  weight?: number; // 体重
}

interface Horse {
  id: string | number;  // UUIDまたは数値IDをサポート
  name: string; // 馬名
  sex: string; // 性別
  color: string; // 毛色
  birthday: string; // 生年月日
  history: HorseHistory[];
  sire: string; // 父
  dam: string; // 母
  dam_sire: string; // 母の父
  primary_image: string; // メイン画像URL
  disease_tags: string; // 病歴タグ
  jbis_url: string; // JBIS URL
  weight: number | null; // 体重（またはnull）
  unsold_count: number | null; // 主取り回数
  total_prize_latest: number; // 最新賞金
  created_at: string;
  updated_at: string;
  unsold?: boolean;
}

interface HorseData {
  metadata: any;
  horses: Horse[];
}

interface CommentedHistory extends HorseHistory {
  originalIndex: number;
}

interface HorseDetailContentProps {
  horse: Horse;
}

interface PageProps {
  params: { id: string };
  searchParams?: { [key: string]: string | string[] | undefined };
}

// 日付フォーマット用のヘルパー関数
const formatDate = (dateString: string) => {
  try {
    return format(new Date(dateString), 'yyyy年M月d日', { locale: ja });
  } catch (e) {
    return dateString; // 日付が不正な場合はそのまま返す
  }
};

// --- 追加ユーティリティ ---
const toArray = (val: any) => Array.isArray(val) ? val : [val];
const formatManYen = (val: number) => isNaN(val) ? '-' : `${(val/10000).toFixed(1)}万円`;

// 落札価格表示用関数
// 落札価格は取得値そのまま（円単位）で表示すること。データは既に円単位で格納されている。
const displayPrice = (price: number | null | undefined, unsold: boolean | undefined) => {
  if (unsold === true) return '主取り';
  if (price === null || price === undefined) return '-';
  return '¥' + price.toLocaleString();
};

// 以前の仕様に合わせた成長率計算
const calculateGrowthRate = (start: number, latest: number) => {
  if (start === 0) return '-';
  const rate = ((latest - start) / start * 100).toFixed(1);
  return (latest - start >= 0 ? '+' : '') + rate;
};

// 賞金は万円単位で表示
// 現在の総賞金はJBISからスクレイピングして取得している点に注意。
const formatPrize = (val: number | string | null | undefined) => {
  if (val === null || val === undefined || val === '' || isNaN(Number(val))) return '-';
  return `${Number(val).toFixed(1)}万円`;
};

// エラーコンポーネント
function ErrorMessage({ message, onRetry }: { message: string; onRetry?: () => void }) {
  return (
    <div className="min-h-screen bg-gray-50 flex items-center justify-center">
      <div className="text-center">
        <h1 className="text-2xl font-bold text-red-600 mb-4">エラー</h1>
        <p className="text-gray-700 mb-6">{message}</p>
        <div className="flex justify-center gap-4">
          <Button asChild>
            <Link href="/">トップに戻る</Link>
          </Button>
          {onRetry && (
            <Button variant="outline" onClick={onRetry}>
              再試行
            </Button>
          )}
        </div>
      </div>
    </div>
  );
}

// ローディングコンポーネント
function LoadingSpinner() {
  return (
    <div className="min-h-screen bg-gray-50 flex items-center justify-center">
      <div className="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-primary"></div>
    </div>
  );
}

/**
 * 馬データを取得する関数
 * @param horseId 取得する馬のID (数値または文字列)
 * @returns 馬データとエラー情報を含むオブジェクト
 */
interface AvailableHorse {
  id: string;
  name: string;
}

// 馬データをフェッチするヘルパー関数
async function fetchHorseData(horseId: string | number): Promise<Response> {
  // horse- プレフィックスを削除
  const id = String(horseId).replace(/^horse-/, '');
  const timestamp = new Date().getTime();
  const url = `/api/horses/${id}?t=${timestamp}`;
  
  console.log(`Fetching from: ${url}`);
  
  try {
    const response = await fetch(url, {
      cache: 'no-store',
      headers: {
        'Cache-Control': 'no-cache, no-store, must-revalidate',
        'Pragma': 'no-cache',
        'Expires': '0'
      }
    });
    
    // レスポンスをクローンして返すことで、複数回読み取り可能にする
    const responseClone = response.clone();
    
    if (!response.ok) {
      console.error(`API Error: ${response.status} ${response.statusText}`);
      try {
        const errorText = await response.text();
        console.error('Error response:', errorText);
      } catch (e) {
        console.error('Error reading error response:', e);
      }
      // エラー時にもクローンしたレスポンスを返す
      return responseClone;
    }
    
    return responseClone;
  } catch (error) {
    console.error('Fetch error:', error);
    throw new Error(`データの取得中にエラーが発生しました: ${error instanceof Error ? error.message : String(error)}`);
  }
}

async function getHorseData(horseId: string | number): Promise<{ 
  horse: Horse | null; 
  error: string | null;
  availableHorses?: AvailableHorse[];
}> {
  if (!horseId) {
    return { horse: null, error: '無効な馬IDです' };
  }

  // horse-{timestamp} 形式のIDから数値IDを抽出
  const extractNumericId = (id: string | number): string => {
    const idStr = String(id);
    // horse-{timestamp} 形式の場合、最後の数値部分を抽出
    const match = idStr.match(/horse-(\d+)$/);
    return match ? match[1] : idStr;
  };

  const numericId = extractNumericId(horseId);
  console.log(`Extracted numeric ID: ${numericId} from original ID: ${horseId}`);

  try {
    // 数値IDで直接APIを呼び出す
    console.log(`Fetching horse data for ID: ${numericId}`);
    let response = await fetchHorseData(numericId);
    
    // 404エラーの場合、horses.jsonから該当する馬を探す
    if (!response.ok && response.status === 404) {
      console.log(`Failed to fetch with ID: ${numericId}, status: ${response.status}, trying to find in horses.json...`);
      
      // 両方のパスを試す
      const possiblePaths = [
        '/static/data/horses.json',  // 古いパス
        '/horses.json.new'           // 新しいパス
      ];
      
      for (const path of possiblePaths) {
        try {
          const horsesResponse = await fetch(path);
          
          if (horsesResponse.ok) {
            const horsesData = await horsesResponse.json();
            // 配列形式とオブジェクト形式の両方に対応
            const horses = Array.isArray(horsesData) 
              ? horsesData 
              : (horsesData.horses || []);
            
            console.log(`Searching in ${path}, found ${horses.length} horses`);
            
            // 1. 完全一致で検索（文字列比較に注意）
            let horse = horses.find((h: any) => {
              const hId = String(h.id || '');
              return hId === String(numericId) || 
                     hId === String(horseId) ||
                     h.detail_url?.includes(String(numericId));
            });
            
            // 2. detail_urlからIDを抽出して検索
            if (!horse) {
              horse = horses.find((h: any) => {
                if (!h.detail_url) return false;
                const idFromUrl = h.detail_url.match(/(?:item|horses|auction\/item|auction\/auction_item)\/(\d+)/)?.[1];
                if (idFromUrl === String(numericId)) {
                  console.log(`Found matching horse by detail_url: ${h.detail_url}, ID: ${h.id}, Name: ${h.name}`);
                  return true;
                }
                return false;
              });
            }
            
            if (horse) {
              // 見つかった馬のIDを使用して再試行
              const horseIdToUse = horse.id || horse.detail_url?.match(/\/(\d+)$/)?.[1];
              if (horseIdToUse) {
                console.log(`Found horse in ${path}. ID: ${horseIdToUse}, Name: ${horse.name || '名前なし'}`);
                response = await fetchHorseData(horseIdToUse);
                if (response.ok) break; // 成功したらループを抜ける
              }
            }
          }
        } catch (e) {
          console.error(`Error loading ${path}:`, e);
        }
      }
      
      if (!response.ok) {
        console.log('対応する馬が見つかりませんでした。');
      }
    
    if (!response.ok) {
      try {
        const errorText = await response.text();
        console.error('APIエラーレスポンス:', response.status, errorText);
        
        try {
          const errorData = JSON.parse(errorText);
          
          // 利用可能な馬の情報を取得
          if (errorData.available_horses && errorData.available_horses.length > 0) {
            return { 
              horse: null, 
              error: errorData.error || `馬が見つかりません (ID: ${horseId})`,
              availableHorses: errorData.available_horses
            };
          } else if (errorData.available_ids && errorData.available_ids.length > 0) {
            // 後方互換性のため、available_ids が存在する場合もサポート
            const availableHorses = errorData.available_ids.map((id: string) => ({
              id,
              name: errorData.horse_names?.[id] || `ID: ${id}`
            })).slice(0, 10); // 最初の10件のみ表示
            
            return { 
              horse: null, 
              error: errorData.error || `馬が見つかりません (ID: ${horseId})`,
              availableHorses
            };
          }
        } catch (e) {
          console.error('Error parsing error response:', e);
          return { 
            horse: null, 
            error: `データの取得に失敗しました (${response.status}): ${errorText.substring(0, 100)}`
          };
        }
      } catch (e) {
        console.error('Error reading error response:', e);
        return { 
          horse: null, 
          error: `データの取得中にエラーが発生しました (${response.status}): ${e instanceof Error ? e.message : String(e)}`
        };
      }
      
      return { 
        horse: null, 
        error: `データの取得に失敗しました (${response.status})`
      };
    }
    
    const data = await response.json();
    console.log('APIレスポンスデータ:', data);
    
    // データが直接返ってきているか、horseプロパティとして返ってきているかを確認
    const horseData = data.horse || data;
    
    if (!horseData) {
      throw new Error('馬のデータが見つかりません');
    }
    
    // 必要なフィールドを変換
    const formattedHorse: Horse = {
      ...horseData,
      id: horseData.id || 0, // デフォルト値として0を設定
      color: horseData.color || '不明',
      birthday: horseData.birthday || '不明',
      history: horseData.history || [],
      primary_image: horseData.primary_image || '',
      disease_tags: horseData.disease_tags || '',
      jbis_url: horseData.jbis_url || '',
      weight: horseData.weight || null,
      unsold_count: horseData.unsold_count || 0,
      total_prize_latest: horseData.total_prize_latest || 0,
      created_at: horseData.created_at || new Date().toISOString(),
      updated_at: horseData.updated_at || new Date().toISOString(),
      // damsire が存在する場合は dam_sire として使用
      dam_sire: horseData.dam_sire || horseData.damsire || '不明',
      // オプショナルなフィールド
      unsold: horseData.unsold || false
    };
    
    console.log('フォーマット後の馬データ:', formattedHorse);
    return { horse: formattedHorse, error: null };
  } catch (error) {
    console.error('馬データの取得中にエラーが発生しました:', error);
    return { 
      horse: null, 
      error: error instanceof Error ? error.message : '不明なエラーが発生しました'
    };
  }
}

// シンプルなエラーコンポーネント

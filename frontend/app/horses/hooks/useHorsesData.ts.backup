import { useState, useEffect, useCallback } from 'react';
import { Horse, HorseData } from '../types';
import { fetchHorsesList, getAuctionHistories } from '../api/horsesApi';

interface HorsesData {
  horses: Horse[];
  loading: boolean;
  error: string | null;
  refreshData: () => Promise<void>;
  metadata?: {
    total_horses: number;
    total_auction_records: number;
    last_updated: string;
  };
}

export const useHorsesData = (): HorsesData => {
  const [horses, setHorses] = useState<Horse[]>([]);
  const [loading, setLoading] = useState<boolean>(true);
  const [error, setError] = useState<string | null>(null);
  const [metadata, setMetadata] = useState<{
    total_horses: number;
    total_auction_records: number;
    last_updated: string;
  } | null>(null);

  const fetchData = useCallback(async () => {
    try {
      setLoading(true);
      setError(null);
      
      console.log('[useHorsesData] 馬データの取得を開始します');
      
      // 馬の一覧を取得
      const response = await fetchHorsesList(true); // 最新のデータのみ取得
      let horsesData: HorseData;
      
      if (typeof response === 'string') {
        console.warn('[useHorsesData] レスポンスが文字列です:', response);
        horsesData = { horses: [] };
      } else if ('data' in response) {
        // APIレスポンスが { data: HorseData } の形式の場合
        horsesData = response.data as HorseData;
      } else {
        // 直接 HorseData が返ってくる場合
        horsesData = response as unknown as HorseData;
      }
      
      console.log(`[useHorsesData] 取得した馬データ: ${horsesData.horses?.length || 0}件`);
      
      // メタデータを保存
      if (horsesData.metadata) {
        setMetadata({
          total_horses: horsesData.metadata.total_horses || 0,
          total_auction_records: horsesData.metadata.total_auction_records || 0,
          last_updated: horsesData.metadata.last_updated || new Date().toISOString()
        });
      }
      
      // データがない場合は早期リターン
      if (!horsesData.horses || horsesData.horses.length === 0) {
        console.warn('[useHorsesData] 取得した馬データが0件です');
        setHorses([]);
        setLoading(false);
        return;
      }
      
      // 各馬のオークション履歴を取得（並列処理でパフォーマンス向上）
      console.log('[useHorsesData] オークション履歴の取得を開始します');
      
      const horsesWithHistory = await Promise.all(
        horsesData.horses.map(async (horse: Horse) => {
          if (!horse.id) {
            console.warn('[useHorsesData] 馬IDが存在しません:', horse);
            return null;
          }
          
          try {
            // 馬のデータからオークション履歴を取得
            const auctionHistories = getAuctionHistories({ horses: [horse] }) || [];
            
            return {
              ...horse,
              auction_histories: Array.isArray(auctionHistories) ? auctionHistories : []
            } as Horse;
          } catch (error) {
            console.error(`[useHorsesData] 馬ID ${horse.id} の履歴取得に失敗:`, error);
            return {
              ...horse,
              auction_histories: []
            } as Horse;
          }
        })
      );

      // nullを除外して型アサーション
      const validHorses = horsesWithHistory.filter((h): h is Horse => h !== null);
      
      console.log(`[useHorsesData] 正常に取得できた馬データ: ${validHorses.length}件`);
      
      setHorses(validHorses);
    } catch (err) {
      const errorMessage = err instanceof Error ? err.message : '不明なエラーが発生しました';
      console.error('[useHorsesData] データ取得エラー:', errorMessage, err);
      setError(`データの取得中にエラーが発生しました: ${errorMessage}`);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    console.log('[useHorsesData] コンポーネントがマウントされました');
    
    // 初回のみデータを取得
    fetchData().catch(err => {
      console.error('[useHorsesData] データ取得中に予期しないエラーが発生しました:', err);
      setError('データの取得中に予期しないエラーが発生しました');
      setLoading(false);
    });
    
    // クリーンアップ関数
    return () => {
      console.log('[useHorsesData] コンポーネントがアンマウントされました');
    };
  }, [fetchData]);

  return {
    horses,
    loading,
    error,
    refreshData: fetchData,
    metadata: metadata || {
      total_horses: 0,
      total_auction_records: 0,
      last_updated: new Date().toISOString()
    }
  };
};
